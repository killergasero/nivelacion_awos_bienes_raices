extends ../layout/app

block styles
    link(rel="stylesheet" href="https://unpkg.com/leaflet@1.8.0/dist/leaflet.css")

block contenido
    div(class="py-5")
        h1(id="titulo" class="text-4xl my-10 font-extrabold text-center")= propiedad.titulo

        div
            a(href="#" class="font-bold text-gray-600 text-sm") Categoria: 
                span(class="font-normal")= propiedad.categoria.nombre

        div(class="mt-5 md:flex md:gap-4 md:items-start")
            div(class="md:w-2/3 bg-white shadow rounded-lg") 
                img(src=`/uploads/${propiedad.imagen}` alt=`imagen de la propiedad ${propiedad.titulo}`)

                div(class="px-5 py-10 space-y-5")
                    p= propiedad.descripcion

                    h2(class="text-2xl leading-6 font-bold text-gray-900") Información Propiedad

                    div(class="grid grid-cols-1 md:grid-cols-2 gap-4")
                        p(class="text-gray-600 font-bold text-xs") WC
                            span(class="text-gray-800 block text-lg")= propiedad.wc
                        
                        p(class="text-gray-600 font-bold text-xs") Habitaciones
                            span(class="text-gray-800 block text-lg")= propiedad.habitaciones

                        p(class="text-gray-600 font-bold text-xs") Estacionamiento
                            span(class="text-gray-800 block text-lg")= propiedad.estacionamiento

                        p(class="text-gray-600 font-bold text-xs") Precio
                            span(class="text-gray-800 block text-lg")= propiedad.precio.nombre

                    h3(class="text-2xl font-bold my-10 text-gray-900") Disponibilidad
                    div(class="mt-2")
                        if propiedad.publicado
                            p(class="text-center p-3 bg-green-100 text-green-700 font-bold rounded-lg")
                                | Propiedad Disponible para la venta
                        else
                            p(class="text-center p-3 bg-red-100 text-red-700 font-bold rounded-lg")
                                | Propiedad Vendida / No disponible

            aside(class="md:w-1/3 bg-white shadow rounded-lg") 
                h3(class="text-center py-10 leading-6 text-2xl font-bold text-gray-900") Ubicación

                div(class="h-96" id="mapa")
                    p(id="lat" class="hidden")= propiedad.lat
                    p(id="lng" class="hidden")= propiedad.lng

                div(class="p-5")
                    p(class="text-gray-600 font-bold text-xs") Dirección
                        span(id="calle" class="text-gray-800 block text-lg")= propiedad.calle

                    if !esVendedor
                        h3(class="text-2xl text-center my-10 font-extrabold text-gray-900") Vendedor
                        
                        if !propiedad.publicado
                            p(class="text-center p-5 bg-gray-100 text-gray-600 font-bold rounded-lg") Esta propiedad ya no acepta ofertas.
                        
                        else if enviado
                            p(class="p-2 text-center bg-green-100 text-green-600 uppercase font-bold") Mensaje Enviado Correctamente

                        else if usuario
                            if yaEnvioOferta
                                div(class="p-4 bg-yellow-100 border-l-4 border-yellow-500 text-yellow-700")
                                    p(class="font-bold") Oferta enviada
                                    p Ya has enviado una oferta para esta propiedad. No es posible enviar una segunda petición.
                            
                            else
                                if errores
                                    div(class="max-w-md mx-auto my-10")
                                        each error in errores
                                            p.bg-red-600.text-white.uppercase.text-xs.text-center.p-2.mb-1.font-bold= error.msg

                                form(method="POST")
                                    input(type="hidden" name="_csrf" value= csrfToken)
                                    
                                    div(class="space-y-5")
                                        div
                                            label(for="mensaje" class="font-bold text-gray-700") Mensaje
                                            textarea(id="mensaje" name="mensaje" class="w-full px-2 py-2 border border-gray-300 rounded-lg shadow placeholder-gray-400" placeholder="Coloca tu mensaje aquí")
                                        
                                        div(class="bg-gray-50 p-4 border border-dashed border-gray-300 rounded-lg")
                                            label(for="oferta" class="font-bold text-gray-700 block mb-2") Realizar una Oferta (Opcional)
                                            div(class="relative mt-1")
                                                div(class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none")
                                                    span(class="text-gray-500 sm:text-sm") $
                                                input(type="number" name="oferta" id="oferta" class="w-full pl-7 pr-2 py-2 border border-gray-300 rounded-lg focus:ring-indigo-500 focus:border-indigo-500" placeholder="0.00")
                                            p(class="text-xs text-gray-500 mt-2") Solo puedes enviar una oferta por propiedad

                                        input(type="submit" value="Enviar Mensaje y Oferta" class="bg-indigo-600 text-white font-bold uppercase text-sm w-full p-2 cursor-pointer hover:bg-indigo-700 transition-colors")
                        else 
                            div(class="flex flex-col items-center justify-center gap-2")
                                p(class="text-center") Si deseas contactar al vendedor
                                a(class="text-indigo-600 font-bold" href="/auth/registro") debes crear una cuenta

block scripts
    script(src="https://unpkg.com/leaflet@1.8.0/dist/leaflet.js")
    script(src="/js/mostrarMapa.js")